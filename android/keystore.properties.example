# Copy to android/keystore.properties (gitignored) and fill in real values.
# Create the keystore first:
#   keytool -genkey -v -keystore zsteps-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias zsteps
storeFile=../zsteps-release.jks
storePassword=CHANGE_ME
keyAlias=zsteps
keyPassword=CHANGE_ME
