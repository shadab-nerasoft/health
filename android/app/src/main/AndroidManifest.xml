<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Re-anchors the step baseline after a reboot (the sensor restarts at
            zero) and rolls the day total over just after local midnight.
        -->
        <receiver
            android:name=".stepcounter.StepEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="com.gtftechnologies.zsteps.DAY_ROLLOVER" />
            </intent-filter>
        </receiver>

        <!--
            Opt-in only, and off by default. Screen-off counting does not need
            it; it exists so the app can react to steps in the background.
        -->
        <service
            android:name=".stepcounter.StepCounterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Home screen widget. Reads the same native step store the app does. -->
        <!--
            Must be exported: the launcher lives in another process and can only
            discover and bind a widget provider that is. With exported="false"
            the widget never appears in the picker at all.
        -->
        <receiver
            android:name=".widget.StepWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.gtftechnologies.zsteps.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/step_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Runtime permission from Android 10 (API 29) onwards; auto-granted below
        that. Required to read TYPE_STEP_COUNTER.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Re-arm the midnight rollover alarm after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 13+: needed for the web push notifications the app already sends. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only exercised when the user opts into background tracking. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!--
        Declared but not required: the app degrades to manual entry when the
        device has no step counter, so it stays installable on those devices.
    -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.stepdetector"
        android:required="false" />
</manifest>
