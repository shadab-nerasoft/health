# Build-time values for the Android APK (`npm run build:mobile`).
# Copy the ones you need into .env.local, or prefix them on the command line.
#
# Where the APK finds the app's own API routes. The static export inside the
# APK has no server behind it, so the AI coach, meal plan, nudge and web-push
# endpoints are called on the deployed origin instead.
#
# Steps, storage, goals, water and the dashboard all work with no network,
# so leaving this unset produces a working offline app with the AI features
# disabled.
NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# Same Supabase values as the web build. Only NEXT_PUBLIC_* keys are inlined
# into the bundle; never put a service-role key or VAPID private key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
